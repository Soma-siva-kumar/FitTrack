# FitTrack - Netlify Serverless Environment Variables Template
# DO NOT commit real secrets or private keys to source control.
# Add these variables in the Netlify Dashboard (Site settings > Environment variables).

# 1. Google Cloud Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=fittrack-service-account@your-gcp-project.iam.gserviceaccount.com

# 2. Google Cloud Service Account Private Key (keep newlines as \n or multi-line)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Google Spreadsheet ID (from your Google Sheet URL: docs.google.com/spreadsheets/d/[GOOGLE_SHEET_ID]/edit)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
